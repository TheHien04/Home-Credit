home_credit_analytics:
  target: dev
  outputs:
    dev:
      type: sqlserver
      driver: "ODBC Driver 18 for SQL Server"
      server: "{{ env_var('DBT_SQLSERVER_HOST') }}"
      port: 1433
      database: "{{ env_var('DBT_SQLSERVER_DATABASE', 'HomeCreditBI') }}"
      schema: dbt
      user: "{{ env_var('DBT_SQLSERVER_USER') }}"
      password: "{{ env_var('DBT_SQLSERVER_PASSWORD') }}"
      encrypt: true
      trust_cert: true
      threads: 4
      retries: 1

