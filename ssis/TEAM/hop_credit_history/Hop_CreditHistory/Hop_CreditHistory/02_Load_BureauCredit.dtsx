    <DTS:Executable
      DTS:refId="Package\03 Reconcile committed rows and finish audit"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{2CC535E7-F8FE-447B-B590-59172FCFC98A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="03 Reconcile committed rows and finish audit"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D1D35BB2-E726-4833-8221-333BCE684C88}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; DECLARE @F BIGINT=?,@B BIGINT=?,@Read BIGINT=?,@Rejected BIGINT=?,@Actual BIGINT; SELECT @Actual=COUNT_BIG(*) FROM stg.[BureauCredit] WHERE BatchID=@B; IF @Actual+@Rejected&lt;&gt;@Read THROW 51402,'Parsed, committed and rejected row counts do not match.',1; IF @Rejected&gt;0 BEGIN EXEC ctl.usp_EndFileLoad @FileLoadID=@F,@LoadStatus='FAILED',@RowsRead=@Read,@RowsAccepted=@Actual,@RowsRejected=@Rejected; THROW 51405,'Conversion rejected records; inspect ctl.RejectedRow.',1; END; EXEC ctl.usp_EndFileLoad @FileLoadID=@F,@LoadStatus='SUCCEEDED',@RowsRead=@Read,@RowsAccepted=@Actual,@RowsRejected=0;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::FileLoadID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::BatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::RowsRead"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::RowsRejected"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\04 Finalize failed audit after pipeline counters settle"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{7115C42A-EA39-43F9-B407-84A1C3C17DE9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="04 Finalize failed audit after pipeline counters settle"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D1D35BB2-E726-4833-8221-333BCE684C88}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; DECLARE @F BIGINT=?,@B BIGINT=?,@Read BIGINT=?,@Actual BIGINT; IF EXISTS(SELECT 1 FROM ctl.ETLFileLoad WHERE FileLoadID=@F AND LoadStatus='RUNNING') BEGIN SELECT @Actual=COUNT_BIG(*) FROM stg.[BureauCredit] WHERE BatchID=@B; IF @Read&lt;@Actual SET @Read=@Actual; DECLARE @Rejected BIGINT=@Read-@Actual; EXEC ctl.usp_EndFileLoad @FileLoadID=@F,@LoadStatus='FAILED',@RowsRead=@Read,@RowsAccepted=@Actual,@RowsRejected=@Rejected; END; THROW 51406,'File load failed. Inspect source row numbers, audit and SSIS diagnostics.',1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::FileLoadID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::BatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::RowsRead"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
