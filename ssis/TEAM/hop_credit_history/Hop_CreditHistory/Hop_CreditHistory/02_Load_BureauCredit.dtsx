      DTS:ObjectName="01 Check shared batch and start file audit"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D1D35BB2-E726-4833-8221-333BCE684C88}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; DECLARE @B BIGINT=?; IF EXISTS(SELECT 1 FROM stg.[BureauCredit] WHERE BatchID=@B) THROW 51400,'Selected source already has staging rows for this batch. Refusing duplicates.',1; IF EXISTS(SELECT 1 FROM ctl.ETLFileLoad f JOIN ctl.SourceFile s ON s.SourceFileID=f.SourceFileID WHERE f.BatchID=@B AND s.FileName=N'bureau.csv' AND f.LoadStatus IN ('RUNNING','SUCCEEDED')) THROW 51401,'File audit already running or succeeded. Check previous execution.',1; DECLARE @F BIGINT,@S INT; EXEC ctl.usp_StartFileLoad @BatchID=@B,@FileName=N'bureau.csv',@FileLoadID=@F OUTPUT,@SourceFileID=@S OUTPUT;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::FileLoadID" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::SourceFileID" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
