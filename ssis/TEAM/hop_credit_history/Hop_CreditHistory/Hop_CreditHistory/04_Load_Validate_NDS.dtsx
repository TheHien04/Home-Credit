  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\01 Validate all seven staging inputs"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{CBEFA3FC-3B3D-4F14-B669-CDC6191B5455}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="01 Validate all seven staging inputs"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CA955945-54CC-4155-BE80-837A80B9D2F0}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; DECLARE @B BIGINT=?; IF NOT EXISTS(SELECT 1 FROM ctl.ETLBatch WHERE BatchID=@B AND BatchStatus='RUNNING') THROW 51407,'Supply the shared RUNNING integration batch.',1; IF NOT EXISTS(SELECT 1 FROM stg.[Application] WHERE BatchID=@B) OR NOT EXISTS(SELECT 1 FROM stg.[PreviousApplication] WHERE BatchID=@B) OR NOT EXISTS(SELECT 1 FROM stg.[BureauCredit] WHERE BatchID=@B) OR NOT EXISTS(SELECT 1 FROM stg.[BureauBalance] WHERE BatchID=@B) OR NOT EXISTS(SELECT 1 FROM stg.[InstallmentPayment] WHERE BatchID=@B) OR NOT EXISTS(SELECT 1 FROM stg.[POSCashBalance] WHERE BatchID=@B) OR NOT EXISTS(SELECT 1 FROM stg.[CreditCardBalance] WHERE BatchID=@B) THROW 51408,'All seven staging tables are required before NDS. Obtain Application and Payment History inputs first.',1; IF (SELECT COUNT(DISTINCT s.FileName) FROM ctl.ETLFileLoad f JOIN ctl.SourceFile s ON s.SourceFileID=f.SourceFileID WHERE f.BatchID=@B AND f.LoadStatus='SUCCEEDED' AND f.RowsRejected=0 AND f.RowsRead=f.RowsAccepted AND s.FileName IN (N'application_train.csv',N'application_test.csv',N'previous_application.csv',N'bureau.csv',N'bureau_balance.csv',N'POS_CASH_balance.csv',N'installments_payments.csv',N'credit_card_balance.csv'))&lt;&gt;8 THROW 51409,'Eight successful per-file audits are required before NDS.',1; EXEC ctl.usp_ValidateHomeCreditStaging @BatchID=@B; IF EXISTS(SELECT 1 FROM ctl.DataQualityResult WHERE BatchID=@B AND TestCode LIKE 'STG[_]%' AND TestStatus='FAIL') THROW 51403,'Staging validation has FAIL. NDS will not run.',1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\02 Load NDS without replacing existing data"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{1D9B6C22-EE74-4504-906B-62EAD847F461}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="02 Load NDS without replacing existing data"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CA955945-54CC-4155-BE80-837A80B9D2F0}"
          SQLTask:SqlStatementSource="EXEC etl.usp_LoadNDS @BatchID=?,@ConfirmReplace=0;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\03 Persist NDS validation and enforce PASS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{67B8D7B4-0A20-4EA7-98EA-E8731499780F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="03 Persist NDS validation and enforce PASS"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CA955945-54CC-4155-BE80-837A80B9D2F0}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; DECLARE @B BIGINT=?; EXEC etl.usp_ValidateNDS @BatchID=@B,@PersistResults=1; IF EXISTS(SELECT 1 FROM ctl.DataQualityResult WHERE BatchID=@B AND TestCode LIKE 'NDS[_]%' AND TestStatus='FAIL') THROW 51404,'NDS validation has FAIL.',1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
