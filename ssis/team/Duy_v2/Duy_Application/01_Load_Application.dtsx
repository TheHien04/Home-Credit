S_PRICE])), '')), TRY_CONVERT(DECIMAL(28,10), TRY_CONVERT(FLOAT, NULLIF(LTRIM(RTRIM(r.[AMT_GOODS_PRICE])), '')))) AS [AMT_GOODS_PRICE],&#10;    CONVERT(NVARCHAR(255), NULLIF(LTRIM(RTRIM(r.[NAME_TYPE_SUITE])), '')) AS [NAME_TYPE_SUITE],&#10;    CONVERT(NVARCHAR(255), NULLIF(LTRIM(RTRIM(r.[NAME_INCOME_TYPE])), '')) AS [NAME_INCOME_TYPE],&#10;    CONVERT(NVARCHAR(255), NULLIF(LTRIM(RTRIM(r.[NAME_EDUCATION_TYPE])), '')) AS [NAME_EDUCATION_TYPE],&#10;    CONVERT(NVARCHAR(255), NULLIF(LTRIM(RTRIM(r.[NAME_FAMILY_STATUS])), '')) AS [NAME_FAMILY_STATUS],&#10;    CONVERT(NVARCHAR(255), NULLIF(LTRIM(RTRIM(r.[NAME_HOUSING_TYPE])), '')) AS [NAME_HOUSING_TYPE],&#10;    COALESCE(TRY_CONVERT(DECIMAL(28,10), NULLIF(LTRIM(RTRIM(r.[REGION_POPULATION_RELATIVE])), '')), TRY_CONVERT(DECIMAL(28,10), TRY_CONVERT(FLOAT, NULLIF(LTRIM(RTRIM(r.[REGION_POPULATION_RELATIVE])), '')))) AS [REGION_POPULATION_RELATIVE],&#10;    TRY_CONVERT(BIGINT, COALESCE(TRY_CONVERT(DECIMAL(28,10), NULLIF(LTRIM(RTRIM(r.[DAYS_BIRTH])), '')), TRY_CONVERT(DECIMAL(28,10), TRY_CONVERT(FLOAT, NULLIF(LTRIM(RTRIM(r.[DAYS_BIRTH])), ''))))) AS [DAYS_BIRTH],&#10;    TRY_CONVERT(BIGINT, COALESCE(TRY_CONVERT(DECIMAL(28,10), NULLIF(LTRIM(RTRIM(r.[DAYS_EMPLOYED])), '')), TRY_CONVERT(DECIMAL(28,10), TRY_CONVERT(FLOAT, NULLIF(LTRIM(RTRIM(r.[DAYS_EMPLOYED])), ''))))) AS [DAYS_EMPLOYED],&#10;    COALESCE(TRY_CONVERT(DECIMAL(28,12), NULLIF(LTRIM(RTRIM(r.[DAYS_REGISTRATION])), '')), TRY_CONVERT(DECIMAL(28,12), TRY_CONVERT(FLOAT, NULLIF(LTRIM(RTRIM(r.[DAYS_REGISTRATION])), '')))) AS [DAYS_REGISTRATION],&#10;    TRY_CONVERT(BIGINT, COALESCE(TRY_CONVERT(DECIMAL(28,10), NULLIF(LTRIM(RTRIM(r.[DAYS_ID_PUBLISH])), '')), TRY_CONVERT(DECIMAL(28,10), TRY_CONVERT(FLOAT, NULLIF(LTRIM(RTRIM(r.[DAYS_ID_PUBLISH])), ''))))) AS [DAYS_ID_PUBLISH],&#10;    TRY_CONVERT(BIGINT, COALESCE(TRY_CONVERT(DECIMAL(28,10), NULLIF(LTRIM(RTRIM(r.[OWN_CAR_AGE])), '')), TRY_CONVERT(DECIMAL(28,10), TRY_CONVERT(FLOAT, NULLIF(LTRIM(RTRIM(r.[OWN_CAR_AGE])), ''))))) AS [OW