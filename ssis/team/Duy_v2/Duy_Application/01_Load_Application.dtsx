    <DTS:Executable DTS:refId="Package\SQL_01_Prepare_Duy_Raw" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Native SSIS Execute SQL Task: SQL_01_Prepare_Duy_Raw" DTS:DTSID="{2E381867-A982-4CD8-89B1-35413D593C57}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL_01_Prepare_Duy_Raw" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables/>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{71FC2573-9B50-4284-AEC3-DC4D940440CD}" SQLTask:SqlStatementSource="-- HOME CREDIT - DUY native SSIS raw buffer. No table in stg/nds/dds is truncated.&#10;SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;IF OBJECT_ID(N'[stg].[Application]', N'U') IS NULL&#10;    THROW 53100, 'Missing stg.Application. Ask SQL owner to deploy SQL first.', 1;&#10;IF OBJECT_ID(N'[ctl].[ETLBatch]', N'U') IS NULL&#10;    THROW 53101, 'Missing ctl.ETLBatch. Ask SQL owner to deploy SQL first.', 1;&#10;IF OBJECT_ID(N'[ctl].[ETLFileLoad]', N'U') IS NULL&#10;    THROW 53102, 'Missing ctl.ETLFileLoad. Ask SQL owner to deploy SQL first.', 1;&#10;IF OBJECT_ID(N'[ctl].[SourceFile]', N'U') IS NULL&#10;    THROW 53103, 'Missing ctl.SourceFile. Ask SQL owner to deploy SQL first.', 1;&#10;IF OBJECT_ID(N'[ctl].[usp_StartETLBatch]', N'P') IS NULL&#10;    THROW 53104, 'Missing ctl.usp_StartETLBatch. Ask SQL owner to deploy SQL first.', 1;&#10;IF OBJECT_ID(N'[ctl].[usp_StartFileLoad]', N'P') IS NULL&#10;    THROW 53105, 'Missing ctl.usp_StartFileLoad. Ask SQL owner to deploy SQL first.', 1;&#10;IF OBJECT_ID(N'[ctl].[usp_EndFileLoad]', N'P') IS NULL&#10;    THROW 53106, 'Missing ctl.usp_EndFileLoad. Ask SQL owner to deploy SQL first.', 1;&#10;IF OBJECT_ID(N'[ctl].[usp_EndETLBatch]', N'P') IS NULL&#10;    THROW 53107, 'Missing ctl.usp_EndETLBatch. Ask SQL owner to deploy SQL first.', 1;&#10;IF SCHEMA_ID(N'duy') IS NULL EXEC(N'CREATE SCHEMA duy');&#10;IF OBJECT_ID(N'[duy].[DuyApplicationRaw]', N'U') IS NULL&#10;BEGIN&#10;    CREATE TABLE [duy].[DuyApplicationRaw]&#10;    (&#10;        [RawRowID] BIGINT IDENTITY(1,1) NOT NULL,&#10;        [DatasetSplit] VARCHAR(5) NOT NULL,&#10;        [SK_ID_CURR] VARCHAR(255) NULL,&#10;        [TARGET] VARCHAR(255) NULL,&#10;        [NAME_CONTRACT_TYPE] VARCHAR(255) NULL,&#10;        [CODE_GENDER] VARCHAR(255) NULL,&#10;        [FLAG_OWN_CAR] VARCHAR(255) NULL,&#10;        [FLAG_OWN_REALTY] VARCHAR(255) NULL,&#10;        [CNT_CHILDREN] VARCHAR(255) NULL,&#10;        [AMT_INCOME_TOTAL] VARCHAR(255) NULL,&#10;        [AMT_CREDIT] VARCHAR(255) NULL,&#10;        [AMT_ANNUITY] VARCHAR(255) NULL,&#10;        [AMT_GOODS_PRICE] VARCHAR(255) NULL,&#10;        [NAME_TYPE_SUITE] VARCHAR(255) NULL,&#10;        [NAME_INCOME_TYPE] VARCHAR(255) NULL,&#10;        [NAME_EDUCATION_TYPE] VARCHAR(255) NULL,&#10;        [NAME_FAMILY_STATUS] VARCHAR(255) NULL,&#10;        [NAME_HOUSING_TYPE] VARCHAR(255) NULL,&#10;        [REGION_POPULATION_RELATIVE] VARCHAR(255) NULL,&#10;        [DAYS_BIRTH] VARCHAR(255) NULL,&#10;        [DAYS_EMPLOYED] VARCHAR(255) NULL,&#10;        [DAYS_REGISTRATION] VARCHAR(255) NULL,&#10;        [DAYS_ID_PUBLISH] VARCHAR(255) NULL,&#10;        [OWN_CAR_AGE] VARCHAR(255) NULL,&#10;        [FLAG_MOBIL] VARCHAR(255) NULL,&#10;        [FLAG_EMP_PHONE] VARCHAR(255) NULL,&#10;        [FLAG_WORK_PHONE] VARCHAR(255) NULL,&#10;        [FLAG_CONT_MOBILE] VARCHAR(255) NULL,&#10;        [FLAG_PHONE] VARCHAR(255) NULL,&#10;        [FLAG_EMAIL] VARCHAR(255) NULL,&#10;        [OCCUPATION_TYPE] VARCHAR(255) NULL,&#10;        [CNT_FAM_MEMBERS] VARCHAR(255) NULL,&#10;        [REGION_RATING_CLIENT] VARCHAR(255) NULL,&#10;        [REGION_RATING_CLIENT_W_CITY] VARCHAR(255) NULL,&#10;        [WEEKDAY_APPR_PROCESS_START] VARCHAR(255) NULL,&#10;        [HOUR_APPR_PROCESS_START] VARCHAR(255) NULL,&#10;        [REG_REGION_NOT_LIVE_REGION] VARCHAR(255) NULL,&#10;        [REG_REGION_NOT_WORK_REGION] VARCHAR(255) NULL,&#10;        [LIVE_REGION_NOT_WORK_REGION] VARCHAR(255) NULL,&#10;        [REG_CITY_NOT_LIVE_CITY] VARCHAR(255) NULL,&#10;        [REG_CITY_NOT_WORK_CITY] VARCHAR(255) NULL,&#10;        [LIVE_CITY_NOT_WORK_CITY] VARCHAR(255) NULL,&#10;        [ORGANIZATION_TYPE] VARCHAR(255) NULL,&#10;        [EXT_SOURCE_1] VARCHAR(255) NULL,&#10;        [EXT_SOURCE_2] VARCHAR(255) NULL,&#10;        [EXT_SOURCE_3] VARCHAR(255) NULL,&#10;        [APARTMENTS_AVG