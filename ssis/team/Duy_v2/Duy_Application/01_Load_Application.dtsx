    <DTS:Executable DTS:refId="Package\SQL_04_Validate_And_Commit" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Native SSIS Execute SQL Task: SQL_04_Validate_And_Commit" DTS:DTSID="{A6237370-E4FE-4746-816A-36118BEC5E3B}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL_04_Validate_And_Commit" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables/>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{71FC2573-9B50-4284-AEC3-DC4D940440CD}" SQLTask:SqlStatementSource="-- HOME CREDIT - DUY native SSIS final load.&#10;-- Runs only AFTER both native SSIS Data Flows succeeded.&#10;-- All writes to shared stg.Application and ctl audit are atomic.&#10;SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10;    BEGIN TRANSACTION;&#10;    DECLARE @AppLockResult INT;&#10;    EXEC @AppLockResult = sys.sp_getapplock&#10;        @Resource = N'Duy_SSIS_Application_Finalize',&#10;        @LockMode = N'Exclusive', @LockOwner = N'Transaction', @LockTimeout = 1000;&#10;    IF @AppLockResult &lt; 0 THROW 53200, 'Concurrent finalize detected; run only one Duy package at a time.', 1;&#10;&#10;    DECLARE @TrainRows BIGINT, @TestRows BIGINT, @BatchID BIGINT;&#10;    SELECT @TrainRows = COUNT_BIG(*) FROM [duy].[DuyApplicationRaw] WHERE DatasetSplit='TRAIN';&#10;    SELECT @TestRows  = COUNT_BIG(*) FROM [duy].[DuyApplicationRaw] WHERE DatasetSplit='TEST';&#10;    IF @TrainRows IS NULL OR @TrainRows = 0 OR @TestRows IS NULL OR @TestRows = 0&#10;        THROW 53201, 'One of TRAIN/TEST raw CSV loads is empty.', 1;&#10;    IF EXISTS (SELECT 1 FROM [duy].[DuyApplicationRaw] WHERE DatasetSplit NOT IN ('TRAIN','TEST'))&#10;        THROW 53202, 'Unexpected DatasetSplit in private raw table.', 1;&#10;&#10;    -- Numeric validation before any shared writes: nullable blanks allowed,&#10;    -- decimal-integer strings such as 2.0 must be integral for BIGINT.&#10;    DECLARE @BadColumn SYSNAME=NULL, @BadValue VARCHAR(255)=NULL, @BadRow BIGINT;&#10;    SELECT TOP (1)&#10;        @BadColumn=x.ColumnName, @BadValue=x.RawValue, @BadRow=r.RawRowID&#10;    FROM [duy].[DuyApplicationRaw] AS r&#10;    CROSS APPLY (VALUES&#10;            (N'SK_ID_CURR', r.[SK_ID_CURR], N'BIGINT'),&#10;            (N'TARGET', r.[TARGET], N'BIGINT'),&#10;            (N'CNT_CHILDREN', r.[CNT_CHILDREN], N'BIGINT'),&#10;            (N'AMT_INCOME_TOTAL', r.[AMT_INCOME_TOTAL], N'DECIMAL(28,10)'),&#10;            (N'AMT_CREDIT', r.[AMT_CREDIT], N'DECIMAL(28,10)'),&#10;            (N'AMT_ANNUITY', r.[AMT_ANNUITY], N'DECIMAL(28,10)'),&#10;            (N'AMT_GOODS_PRICE', r.[AMT_GOODS_PRICE], N'DECIMAL(28,10)'),&#10;            (N'REGION_POPULATION_RELATIVE', r.[REGION_POPULATION_RELATIVE], N'DECIMAL(28,10)'),&#10;            (N'DAYS_BIRTH', r.[DAYS_BIRTH], N'BIGINT'),&#10;            (N'DAYS_EMPLOYED', r.[DAYS_EMPLOYED], N'BIGINT'),&#10;            (N'DAYS_REGISTRATION', r.[DAYS_REGISTRATION], N'DECIMAL(28,12)'),&#10;            (N'DAYS_ID_PUBLISH', r.[DAYS_ID_PUBLISH], N'BIGINT'),&#10;            (N'OWN_CAR_AGE', r.[OWN_CAR_AGE], N'BIGINT'),&#10;            (N'FLAG_MOBIL', r.[FLAG_MOBIL], N'BIGINT'),&#10;            (N'FLAG_EMP_PHONE', r.[FLAG_EMP_PHONE], N'BIGINT'),&#10;            (N'FLAG_WORK_PHONE', r.[FLAG_WORK_PHONE], N'BIGINT'),&#10;            (N'FLAG_CONT_MOBILE', r.[FLAG_CONT_MOBILE], N'BIGINT'),&#10;            (N'FLAG_PHONE', r.[FLAG_PHONE], N'BIGINT'),&#10;            (N'FLAG_EMAIL', r.[FLAG_EMAIL], N'BIGINT'),&#10;            (N'CNT_FAM_MEMBERS', r.[CNT_FAM_MEMBERS], N'BIGINT'),&#10;            (N'REGION_RATING_CLIENT', r.[REGION_RATING_CLIENT], N'BIGINT'),&#10;            (N'REGION_RATING_CLIENT_W_CITY', r.[REGION_RATING_CLIENT_W_CITY], N'BIGINT'),&#10;            (N'HOUR_APPR_PROCESS_START', r.[HOUR_APPR_PROCESS_START], N'BIGINT'),&#10;            (N'REG_REGION_NOT_LIVE_REGION', r.[REG_REGION_NOT_LIVE_REGION], N'BIGINT'),&#10;            (N'REG_REGION_NOT_WORK_REGION', r.[REG_REGION_NOT_WORK_REGION], N'BIGINT'),&#10;            (N'LIVE_REGION_NOT_WORK_REGION', r.[LIVE_REGION_NOT_WORK_REGION], N'BIGINT'),&#10;            (N'REG_CITY_NOT_LIVE_CITY', r.[REG_CITY_NOT_LIVE_CITY], N'BIGINT'),&#10;            (N'REG_CITY_NOT_WORK_CITY', r.[REG_CITY_NOT_WORK_CITY], N'BIGINT'),&#10;            (N'LIVE_CITY_NOT_WORK_CITY', r.[LIVE_CITY_NOT_WORK_CITY], N'BIGINT'),&#10;            (N'EXT_SOURCE_1', r.[EXT_SOURCE_1], N'DECIMAL(28,10)'),&#10;            (N'EXT_SOURCE_2', r.[EXT_SOURCE_2], N'DECIMAL(28,10)'),&#10;            (N'EXT_SOURCE_3', r.[EXT_SOURCE_3], N'DECIMAL(28,10)'),&#10;            (N'APARTMENTS_AVG', r.[APARTMENTS_AVG], N'DECIMAL(28,10)'),&#10;            (N'BASEMENTAREA_AVG', r.[BASEMENTAREA_AVG], N'DECIMAL(28,10)'),&#10;            (N'YEARS_BEGINEXPLUATATION_AVG', r.[YEARS_BEGINEXPLUATATION_AVG], N'DECIMAL(28,10)'),&#10;            (N'YEARS_BUILD_AVG', r.[YEARS_BUILD_AVG], N'DECIMAL(28,10)'),&#10;            (N'COMMONAREA_AVG', r.[COMMONAREA_AVG], N'DECIMAL(28,10)'),&#10;            (N'ELEVATORS_AVG', r.[ELEVATORS_AVG], N'DECIMAL(28,10)'),&#10;            (N'ENTRANCES_AVG', r.[ENTRANCES_AVG], N'DECIMAL(28,10)'),&#10;            (N'FLOORSMAX_AVG', r.[FLOORSMAX_AVG], N'DECIMAL(28,10)'),&#10;            (N'FLOORSMIN_AVG', r.[FLOORSMIN_AVG], N'DECIMAL(28,10)'),&#10;            (N'LANDAREA_AVG', r.[LANDAREA_AVG], N'DECIMAL(28,10)'),&#10;            (N'LIVINGAPARTMENTS_AVG', r.[LIVINGAPARTMENTS_AVG], N'DECIMAL(28,10)'),&#10;            (N'LIVINGAREA_AVG', r.[LIVINGAREA_AVG], N'DECIMAL(28,10)'),&#10;            (N'NONLIVINGAPARTMENTS_AVG', r.[NONLIVINGAPARTMENTS_AVG], N'DECIMAL(28,10)'),&#10;            (N'NONLIVINGAREA_AVG', r.[NONLIVINGAREA_AVG], N'DECIMAL(28,10)'),&#10;            (N'APARTMENTS_MODE', r.[APARTMENTS_MODE], N'DECIMAL(28,10)'),&#10;            (N'BASEMENTAREA_MODE', r.[BASEMENTAREA_MODE], N'DECIMAL(28,10)'),&#10;            (N'YEARS_BEGINEXPLUATATION_MODE', r.[YEARS_BEGINEXPLUATATION_MODE], N'DECIMAL(28,10)'),&#10;            (N'YEARS_BUILD_MODE', r.[YEARS_BUILD_MODE], N'DECIMAL(28,10)'),&#10;            (N'COMMONAREA_MODE', r.[COMMONAREA_MODE], N'DECIMAL(28,10)'),&#10;            (N'ELEVATORS_MODE', r.[ELEVATORS_MODE], N'DECIMAL(28,10)'),&#10;            (N'ENTRANCES_MODE', r.[ENTRANCES_MODE], N'DECIMAL(28,10)'),&#10;            (N'FLOORSMAX_MODE', r.[FLOORSMAX_MODE], N'DECIMAL(28,10)'),&#10;            (N'FLOORSMIN_MODE', r.[FLOORSMIN_MODE], N'DECIMAL(28,10)'),&#10;            (N'LANDAREA_MODE', r.[LANDAREA_MODE], N'DECIMAL(28,10)'),&#10;            (N'LIVINGAPARTMENTS_MODE', r.[LIVINGAPARTMENTS_MODE], N'DECIMAL(28,10)'),&#10;            (N'LIVINGAREA_MODE', r.[LIVINGAREA_MODE], N'DECIMAL(28,10)'),&#10;            (N'NONLIVINGAPARTMENTS_MODE', r.[NONLIVINGAPARTMENTS_MODE], N'DECIMAL(28,10)'),&#10;            (N'NONLIVINGAREA_MODE', r.[NONLIVINGAREA_MODE], N'DECIMAL(28,10)'),&#10;            (N'APARTMENTS_MEDI', r.[APARTMENTS_MEDI], N'DECIMAL(28,10)'),&#10;            (N'BASEMENTAREA_MEDI', r.[BASEMENTAREA_MEDI], N'DECIMAL(28,10)'),&#10;            (N'YEARS_BEGINEXPLUATATION_MEDI', r.[YEARS_BEGINEXPLUATATION_MEDI], N'DECIMAL(28,10)'),&#10;            (N'YEARS_BUILD_MEDI', r.[YEARS_BUILD_MEDI], N'DECIMAL(28,10)'),&#10;            (N'COMMONAREA_MEDI', r.[COMMONAREA_MEDI], N'DECIMAL(28,10)'),&#10;            (N'ELEVATORS_MEDI', r.[ELEVATORS_MEDI], N'DECIMAL(28,10)'),&#10;            (N'ENTRANCES_MEDI', r.[ENTRANCES_MEDI], N'DECIMAL(28,10)'),&#10;            (N'FLOORSMAX_MEDI', r.[FLOORSMAX_MEDI], N'DECIMAL(28,10)'),&#10;            (N'FLOORSMIN_MEDI', r.[FLOORSMIN_MEDI], N'DECIMAL(28,10)'),&#10;            (N'LANDAREA_MEDI', r.[LANDAREA_MEDI], N'DECIMAL(28,10)'),&#10;            (N'LIVINGAPARTMENTS_MEDI', r.[LIVINGAPARTMENTS_MEDI], N'DECIMAL(28,10)'),&#10;            (N'LIVINGAREA_MEDI', r.[LIVINGAREA_MEDI], N'DECIMAL(28,10)'),&#10;            (N'NONLIVINGAPARTMENTS_MEDI', r.[NONLIVINGAPARTMENTS_MEDI], N'DECIMAL(28,10)'),&#10;            (N'NONLIVINGAREA_MEDI', r.[NONLIVINGAREA_MEDI], N'DECIMAL(28,10)'),&#10;            (N'TOTALAREA_MODE', r.[TOTALAREA_MODE], N'DECIMAL(28,10)'),&#10;            (N'OBS_30_CNT_SOCIAL_CIRCLE', r.[OBS_30_CNT_SOCIAL_CIRCLE], N'BIGINT'),&#10;            (N'DEF_30_CNT_SOCIAL_CIRCLE', r.[DEF_30_CNT_SOCIAL_CIRCLE], N'BIGINT'),&#10;            (N'OBS_60_CNT_SOCIAL_CIRCLE', r.[OBS_60_CNT_SOCIAL_CIRCLE], N'BIGINT'),&#10;            (N'DEF_60_CNT_SOCIAL_CIRCLE', r.[DEF_60_CNT_SOCIAL_CIRCLE], N'BIGINT'),&#10;            (N'DAYS_LAST_PHONE_CHANGE', r.[DAYS_LAST_PHONE_CHANGE], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_2', r.[FLAG_DOCUMENT_2], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_3', r.[FLAG_DOCUMENT_3], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_4', r.[FLAG_DOCUMENT_4], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_5', r.[FLAG_DOCUMENT_5], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_6', r.[FLAG_DOCUMENT_6], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_7', r.[FLAG_DOCUMENT_7], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_8', r.[FLAG_DOCUMENT_8], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_9', r.[FLAG_DOCUMENT_9], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_10', r.[FLAG_DOCUMENT_10], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_11', r.[FLAG_DOCUMENT_11], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_12', r.[FLAG_DOCUMENT_12], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_13', r.[FLAG_DOCUMENT_13], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_14', r.[FLAG_DOCUMENT_14], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_15', r.[FLAG_DOCUMENT_15], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_16', r.[FLAG_DOCUMENT_16], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_17', r.[FLAG_DOCUMENT_17], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_18', r.[FLAG_DOCUMENT_18], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_19', r.[FLAG_DOCUMENT_19], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_20', r.[FLAG_DOCUMENT_20], N'BIGINT'),&#10;            (N'FLAG_DOCUMENT_21', r.[FLAG_DOCUMENT_21], N'BIGINT'),&#10;            (N'AMT_REQ_CREDIT_BUREAU_HOUR', r.[AMT_REQ_CREDIT_BUREAU_HOUR], N'BIGINT'),&#10;            (N'AMT_REQ_CREDIT_BUREAU_DAY', r.[AMT_REQ_CREDIT_BUREAU_DAY], N'BIGINT'),&#10;            (N'AMT_REQ_CREDIT_BUREAU_WEEK', r.[AMT_REQ_CREDIT_BUREAU_WEEK], N'BIGINT'),&#10;            (N'AMT_REQ_CREDIT_BUREAU_MON', r.[AMT_REQ_CREDIT_BUREAU_MON], N'BIGINT'),&#10;            (N'AMT_REQ_CREDIT_BUREAU_QRT', r.[AMT_REQ_CREDIT_BUREAU_QRT], N'BIGINT'),&#10;            (N'AMT_REQ_CREDIT_BUREAU_YEAR', r.[AMT_REQ_CREDIT_BUREAU_YEAR], N'BIGINT')&#10;    ) AS x(ColumnName, RawValue, ExpectedSqlType)&#10;    CROSS APPLY (VALUES (NULLIF(LTRIM(RTRIM(x.RawValue)), ''))) AS z(CleanValue)&#10;    CROSS APPLY (VALUES (COALESCE(TRY_CONVERT(DECIMAL(28,12), z.CleanValue), TRY_CONVERT(DECIMAL(28,12), TRY_CONVERT(FLOAT, z.CleanValue))))) AS p(AsDecimal)&#10;    WHERE z.CleanValue IS NOT NULL AND&#10;    (&#10;        p.AsDecimal IS NULL&#10;        OR (x.ExpectedSqlType='BIGINT' AND&#10;            (p.AsDecimal &lt;&gt; FLOOR(p.AsDecimal) OR&#10;             TRY_CONVERT(BIGINT, p.AsDecimal) IS NULL))&#10;    )&#10;    ORDER BY r.RawRowID;&#10;    IF @BadColumn IS NOT NULL&#10;    BEGIN&#10;        DECLARE @ErrorMessage NVARCHAR(2048) = CONCAT(&#10;            N'Invalid numeric value in raw row ', @BadRow,&#10;            N', column ', @BadColumn, N': ', LEFT(@BadValue,100));&#10;        THROW 53203, @ErrorMessage, 1;&#10;    END;&#10;&#10;    IF EXISTS (&#10;      SELECT 1 FROM [duy].[DuyApplicationRaw]&#10;      WHERE NULLIF(LTRIM(RTRIM([SK_ID_CURR])), '') IS NULL&#10;    ) THROW 53204, 'SK_ID_CURR must not be blank.', 1;&#10;    IF EXISTS (&#10;      SELECT 1 FROM [duy].[DuyApplicationRaw]&#10;      WHERE DatasetSplit='TRAIN' AND ([TARGET] IS NULL OR NULLIF(LTRIM(RTRIM([TARGET])), '') NOT IN ('0','1'))&#10;    ) THROW 53205, 'TRAIN TARGET must be 0 or 1.', 1;&#10;    IF EXISTS (&#10;      SELECT 1 FROM [duy].[DuyApplicationRaw]&#10;      WHERE DatasetSplit='TEST' AND NULLIF(LTRIM(RTRIM([TARGET])), '') IS NOT NULL&#10;    ) THROW 53206, 'TEST TARGET must be NULL.', 1;&#10;    IF EXISTS (&#10;      SELECT 1 FROM [duy].[DuyApplicationRaw]&#10;      GROUP BY DatasetSplit, SK_ID_CURR HAVING COUNT_BIG(*) &gt; 1&#10;    ) THROW 53207, 'Duplicate SK_ID_CURR in a source split.', 1;&#10;&#10;    EXEC ctl.usp_StartETLBatch&#10;      @PipelineName=N'HomeCredit_Application_Duy_NativeSSIS', @BatchID=@BatchID OUTPUT;&#10;&#10;    INSERT INTO [stg].[Application] (&#10;        [BatchID], [SourceRowNumber], [DatasetSplit],&#10;        [SK_ID_CURR],&#10;        [TARGET],&#10;        [NAME_CONTRACT_TYPE],&#10;        [CODE_GENDER],&#10;        [FLAG_OWN_CAR],&#10;        [FLAG_OWN_REALTY],&#10;        [CNT_CHILDREN],&#10;        [AMT_INCOME_TOTAL],&#10;        [AMT_CREDIT],&#10;        [AMT_ANNUITY],&#10;        [AMT_GOODS_PRICE],&#10;        [NAME_TYPE_SUITE],&#10;        [NAME_INCOME_TYPE],&#10;        [NAME_EDUCATION_TYPE],&#10;        [NAME_FAMILY_STATUS],&#10;        [NAME_HOUSING_TYPE],&#10;        [REGION_POPULATION_RELATIVE],&#10;        [DAYS_BIRTH],&#10;        [DAYS_EMPLOYED],&#10;        [DAYS_REGISTRATION],&#10;        [DAYS_ID_PUBLISH],&#10;        [OWN_CAR_AGE],&#10;        [FLAG_MOBIL],&#10;        [FLAG_EMP_PHONE],&#10;        [FLAG_WORK_PHONE],&#10;        [FLAG_CONT_MOBILE],&#10;        [FLAG_PHONE],&#10;        [FLAG_EMAIL],&#10;        [OCCUPATION_TYPE],&#10;        [CNT_FAM_MEMBERS],&#10;        [REGION_RATING_CLIENT],&#10;        [REGION_RATING_CLIENT_W_CITY],&#10;        [WEEKDAY_APPR_PROCESS_START],&#10;        [HOUR_APPR_PROCESS_START],&#10;        [REG_REGION_NOT_LIVE_REGION],&#10;        [REG_REGION_NOT_WORK_REGION],&#10;        [LIVE_REGION_NOT_WORK_REGION],&#10;        [REG_CITY_NOT_LIVE_CITY],&#10;        [REG_CITY_NOT_WORK_CITY],&#10;        [LIVE_CITY_NOT_WORK_CITY],&#10;        [ORGANIZATION_TYPE],&#10;        [EXT_SOURCE_1],&#10;        [EXT_SOURCE_2],&#10;        [EXT_SOURCE_3],&#10;        [APARTMENTS_AVG],&#10;        [BASEMENTAREA_AVG],&#10;        [YEARS_BEGINEXPLUATATION_AVG],&#10;        [YEARS_BUILD_AVG],&#10;        [COMMONAREA_AVG],&#10;        [ELEVATORS_AVG],&#10;        [ENTRANCES_AVG],&#10;        [FLOORSMAX_AVG],&#10;        [FLOORSMIN_AVG],&#10;        [LANDAREA_AVG],&#10;        [LIVINGAPARTMENTS_AVG],&#10;        [LIVINGAREA_AVG],&#10;        [NONLIVINGAPARTMENTS_AVG],&#10;        [NONLIVINGAREA_AVG],&#10;        [APARTMENTS_MODE],&#10;        [BASEMENTAREA_MODE],&#10;        [YEARS_BEGINEXPLUATATION_MODE],&#10;        [YEARS_BUILD_MODE],&#10;        [COMMONAREA_MODE],&#10;        [ELEVATORS_MODE],&#10;        [ENTRANCES_MODE],&#10;        [FLOORSMAX_MODE],&#10;        [FLOORSMIN_MODE],&#10;        [LANDAREA_MODE],&#10;        [LIVINGAPARTMENTS_MODE],&#10;        [LIVINGAREA_MODE],&#10;        [NONLIVINGAPARTMENTS_MODE],&#10;        [NONLIVINGAREA_MODE],&#10;        [APARTMENTS_MEDI],&#10;        [BASEMENTAREA_MEDI],&#10;        [YEARS_BEGINEXPLUATATION_MEDI],&#10;        [YEARS_BUILD_MEDI],&#10;        [COMMONAREA_MEDI],&#10;        [ELEVATORS_MEDI],&#10;        [ENTRANCES_MEDI],&#10;        [FLOORSMAX_MEDI],&#10;        [FLOORSMIN_MEDI],&#10;        [LANDAREA_MEDI],&#10;        [LIVINGAPARTMENTS_MEDI],&#10;        [LIVINGAREA_MEDI],&#10;        [NONLIVINGAPARTMENTS_MEDI],&#10;        [NONLIVINGAREA_MEDI],&#10;        [FONDKAPREMONT_MODE],&#10;        [HOUSETYPE_MODE],&#10;        [TOTALAREA_MODE],&#10;        [WALLSMATERIAL_MODE],&#10;        [EMERGENCYSTATE_MODE],&#10;        [OBS_30_CNT_SOCIAL_CIRCLE],&#10;        [DEF_30_CNT_SOCIAL_CIRCLE],&#10;        [OBS_60_CNT_SOCIAL_CIRCLE],&#10;        [DEF_60_CNT_SOCIAL_CIRCLE],&#10;        [DAYS_LAST_PHONE_CHANGE],&#10;        [FLAG_DOCUMENT_2],&#10;        [FLAG_DOCUMENT_3],&#10;        [FLAG_DOCUMENT_4],&#10;        [FLAG_DOCUMENT_5],&#10;        [FLAG_DOCUMENT_6],&#10;        [FLAG_DOCUMENT_7],&#10;        [FLAG_DOCUMENT_8],&#10;        [FLAG_DOCUMENT_9],&#10;        [FLAG_DOCUMENT_10],&#10;        [FLAG_DOCUMENT_11],&#10;        [FLAG_DOCUMENT_12],&#10;        [FLAG_DOCUMENT_13],&#10;        [FLAG_DOCUMENT_14],&#10;        [FLAG_DOCUMENT_15],&#10;        [FLAG_DOCUMENT_16],&#10;        [FLAG_DOCUMENT_17],&#10;        [FLAG_DOCUMENT_18],&#10;        [FLAG_DOCUMENT_19],&#10;        [FLAG_DOCUMENT_20],&#10;        [FLAG_DOCUMENT_21],&#10;        [AMT_REQ_CREDIT_BUREAU_HOUR],&#10;        [AMT_REQ_CREDIT_BUREAU_DAY],&#10;        [AMT_REQ_CREDIT_BUREAU_WEEK],&#10;  