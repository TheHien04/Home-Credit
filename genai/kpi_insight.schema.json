{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home Credit grounded KPI insight",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "metric_ids", "caveats"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "metric_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "caveats": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "recommended_checks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
